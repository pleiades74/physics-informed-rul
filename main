        'curriculum.pdf')

    print(f"  ✓ figures saved to {fig_dir}")
    print("\n✅ STAGE 7 complete.")

# =============================================================
# LOBOCV — Leave-One-Bearing-Out Cross-Validation
# =============================================================
# Supports two modes:
#   fixed_alpha=None   → use per-bearing α from stage1.pt (current)
#   fixed_alpha=<float> → override all RUL targets to y = 1 - τ^α,
#                          set C = α and m = (α-1)/α uniformly,
#                          use a SEPARATE cache dir so results don't
#                          collide with the per-bearing runs.
LOBOCV_DIR = f"/kaggle/working/mt_supinn_v3_seed{CURRENT_SEED}/lobocv"
os.makedirs(LOBOCV_DIR, exist_ok=True)

LEARN_BEARINGS = ['Bearing1_1', 'Bearing1_2', 'Bearing2_1',
                  'Bearing2_2', 'Bearing3_1', 'Bearing3_2']
ALL_BEARINGS = [
    # 6 learning bearings
    'Bearing1_1', 'Bearing1_2', 'Bearing2_1', 'Bearing2_2',
    'Bearing3_1', 'Bearing3_2',
    # 11 test-pool bearings
    'Bearing1_3', 'Bearing1_4', 'Bearing1_5', 'Bearing1_6', 'Bearing1_7',
    'Bearing2_3', 'Bearing2_4', 'Bearing2_5', 'Bearing2_6', 'Bearing2_7',
    'Bearing3_3',
]

def _lobocv_fold_assignment():
    n = len(ALL_BEARINGS)
    folds = []
    for i in range(n):
        test_b = ALL_BEARINGS[i]
        val_b = ALL_BEARINGS[(i + 1) % n]
        train_bs = [b for b in ALL_BEARINGS if b != test_b and b != val_b]
        folds.append({'fold': i + 1,
                      'test': test_b, 'val': val_b, 'train': train_bs})
    return folds


def _lobocv_path(cache_dir, fold_id, arm_name):
    return os.path.join(cache_dir, f"fold{fold_id}_{arm_name}.json")


def _lobocv_load(cache_dir, fold_id, arm_name):
    p = _lobocv_path(cache_dir, fold_id, arm_name)
    if not os.path.exists(p):
        return None
    with open(p) as f:
        return json.load(f)


def _lobocv_save(cache_dir, fold_id, arm_name, payload):
    with open(_lobocv_path(cache_dir, fold_id, arm_name), 'w') as f:
        json.dump(payload, f, indent=2, default=str)


def _precompute_bearing_weights(s1, config):
    """Fit GPR per bearing over the merged 17-bearing pool."""
    # 6 learning bearings
    learn = tuple(np.concatenate(
        [s1['prono_train'][i], s1['prono_val'][i], s1['prono_test'][i]], axis=0)
        for i in range(7))

    # 11 test-pool bearings (weights will be recomputed below)
    test_weights = np.ones(len(s1['pr_test_bearings']), dtype=np.float32)
    test = (s1['pr_test_vib'], s1['pr_test_ews_scaled'], s1['pr_test_rul'],
            s1['pr_test_bearings'], s1['seq_ids_testpool'],
            s1['pr_test_temporal'], test_weights)

    full = tuple(np.concatenate([learn[i], test[i]], axis=0) for i in range(7))

    gpr = GPRRateEstimator(
        kernel_type=config.gpr_kernel, length_scale=config.gpr_length_scale,
        noise=config.gpr_noise, n_restarts=config.gpr_n_restarts,
        normalize_y=config.gpr_normalize_y)

    _, _, y_rul, bearings, _, temporal, _ = full
    per_bearing_weights = {}
    for b in ALL_BEARINGS:
        mask = bearings == b
        if not mask.any():
            print(f"  [warn] {b}: no samples in pool")
            continue
        order = np.argsort(temporal[mask])
        seq_t = temporal[mask][order]
        seq_r = y_rul[mask][order]
        gpr_out = gpr.fit_predict(seq_t, seq_r)
        s2 = gpr_out['sigma2']
        s2 = np.where(np.isnan(s2), np.nanmedian(s2), s2)
        w = 1.0 / (s2 + config.sigma_eps)
        w = w / (np.mean(w) + 1e-12)
        w = np.clip(w, 0.0, 100.0)
        per_bearing_weights[b] = w
        print(f"  [LOBOCV weights] {b}: n={len(seq_t)} "
              f"w∈[{w.min():.3f},{w.max():.3f}]")
    return full, per_bearing_weights


def _build_fold_data(full, per_bearing_weights, fold_spec,
                     noise_sigma=None, keep_frac=None,
                     input_noise_sigma=None):
    """
    Build fold-specific train/val/test, optionally adding label noise
    or sparsifying only the TRAIN set. Val and test stay clean so the
    A0 vs A2 comparison is fair.
    """
    X_vib, X_ews, y_rul, bearings, seq_ids, temporal, _ = full

    def _slice(mask_bearings):
        m = np.isin(bearings, mask_bearings)
        idx = np.where(m)[0]
        w = np.ones(len(idx), dtype=np.float32)
        for b in mask_bearings:
            if b not in per_bearing_weights:
                continue
            is_b = (bearings[idx] == b)
            if not is_b.any():
                continue
            pos_in_slice = np.where(is_b)[0]
            b_temporal = temporal[idx][pos_in_slice]
            sort_order = np.argsort(b_temporal)
            pos_sorted = pos_in_slice[sort_order]
            w_sorted = per_bearing_weights[b]
            n = min(len(pos_sorted), len(w_sorted))
            w[pos_sorted[:n]] = w_sorted[:n]
        return (X_vib[m], X_ews[m], y_rul[m], bearings[m],
                seq_ids[m], temporal[m], w)

    p_train = _slice(fold_spec['train'])
    p_val = _slice([fold_spec['val']])
    p_test = _slice([fold_spec['test']])

    # ---- apply train-only label noise ----
    if noise_sigma is not None and noise_sigma > 0:
        Xv, Xe, y, b, s, t, w = p_train
        rng = np.random.RandomState(CURRENT_SEED + 1000 + fold_spec.get('fold', 0))
        noise = rng.normal(0.0, noise_sigma, len(y)).astype(np.float32)
        y = np.clip(y + noise, 0.0, 1.0).astype(np.float32)
        p_train = (Xv, Xe, y, b, s, t, w)
        print(f"    [label-noise] train targets: σ={noise_sigma}, "
              f"mean={float(y.mean()):.3f}, std={float(y.std()):.3f}")

    # ---- apply train-only input noise ----
    # sigma is expressed as a fraction of the per-channel std of the
    # training set, so the noise magnitude scales with signal strength.
    if input_noise_sigma is not None and input_noise_sigma > 0:
        Xv, Xe, y, b, s, t, w = p_train
        rng = np.random.RandomState(CURRENT_SEED + 3000 + fold_spec.get('fold', 0))
        # Xv: (n, window, channels)
        per_ch_std = Xv.reshape(-1, Xv.shape[-1]).std(axis=0)  # (channels,)
        per_ch_std = np.maximum(per_ch_std, 1e-6)
        noise = rng.normal(
            0.0,
            input_noise_sigma * per_ch_std[None, None, :],
            Xv.shape,
        ).astype(np.float32)
        Xv = (Xv + noise).astype(np.float32)
        p_train = (Xv, Xe, y, b, s, t, w)
        print(f"    [input-noise] train X_vib: σ={input_noise_sigma} "
              f"× per-channel std")

    # ---- apply train-only subsampling ----
    if keep_frac is not None and 0.0 < keep_frac < 1.0:
        Xv, Xe, y, b, s, t, w = p_train
        n_orig = len(y)
        n_keep = max(int(n_orig * keep_frac), 200)
        if n_keep < n_orig:
            rng = np.random.RandomState(CURRENT_SEED + 2000 + fold_spec.get('fold', 0))
            idx = np.sort(rng.choice(n_orig, n_keep, replace=False))
            p_train = (Xv[idx], Xe[idx], y[idx], b[idx],
                       s[idx], t[idx], w[idx])
            print(f"    [sparsity] train: {n_orig} → {n_keep} windows "
                  f"(keep_frac={keep_frac})")

    return p_train, p_val, p_test



def run_lobocv(folds_to_run=None, arms_to_run=None, epochs_override=None,
               fixed_alpha=None, target_noise_sigma=None,
               sparsity_keep_frac=None, input_noise_sigma=None,
               tag_suffix=''):
    """
    LOBOCV with optional target noise, train sparsity, or fixed-α override.
    Each variant writes to its own cache dir; safe to run all variants
    sequentially without overwriting each other.
    """
    variant_parts = []
    if fixed_alpha is not None:
        variant_parts.append(f'alpha{fixed_alpha}')
    if target_noise_sigma is not None and target_noise_sigma > 0:
        variant_parts.append(f'noise{target_noise_sigma}')
    if sparsity_keep_frac is not None and sparsity_keep_frac < 1.0:
        variant_parts.append(f'sparse{sparsity_keep_frac}')
    if input_noise_sigma is not None and input_noise_sigma > 0:
        variant_parts.append(f'xnoise{input_noise_sigma}')
    variant = '_'.join(variant_parts) if variant_parts else 'clean'
    if tag_suffix:
        variant += '_' + tag_suffix
    # Include the target mode in the cache key so that re-running stage 1
    # with a different `rul_target_mode` produces a fresh cache directory
    # rather than silently reusing results from a different target.
    tmode = getattr(ConfigV3(), 'rul_target_mode', 'power')
    if tmode != 'power':
        variant += f'_tgt{tmode}'

    print(f"\n{'=' * 80}\nLOBOCV — Seed {CURRENT_SEED} — variant={variant}\n{'=' * 80}")

    s1 = load_stage1()
    config = ConfigV3(**s1['config_dict'])
    config.random_state = CURRENT_SEED
    config.output_dir = STAGE_DIR
    if epochs_override is not None:
        config.epochs = epochs_override

    cache_dir = os.path.join(STAGE_DIR, f"lobocv_{variant}")
    os.makedirs(cache_dir, exist_ok=True)
    print(f"  cache: {cache_dir}")

    # ---- fixed-alpha override (unchanged) ----
    if fixed_alpha is not None:
        fa = float(fixed_alpha)
        def _regen(tup):
            Xv, Xe, _y, b, s, t, w = tup
            tau = np.clip(t, 0.0, 1.0)
            return (Xv, Xe, (1.0 - tau ** fa).astype(np.float32), b, s, t, w)
        s1['prono_train'] = _regen(s1['prono_train'])
        s1['prono_val']   = _regen(s1['prono_val'])
        s1['prono_test']  = _regen(s1['prono_test'])
        s1['pr_test_rul'] = (1.0 - np.clip(s1['pr_test_temporal'], 0, 1) ** fa
                             ).astype(np.float32)
        s1['pr_val_rul']  = (1.0 - np.clip(s1['pr_val_temporal'], 0, 1) ** fa
                             ).astype(np.float32)
        s1['C_table'] = np.full_like(s1['C_table'], fa, dtype=np.float32)
        s1['m_table'] = np.full_like(s1['m_table'], (fa-1)/fa, dtype=np.float32)
        s1['C_median'] = fa
        s1['m_median'] = (fa-1)/fa

    arms_all = {
        'A0_no_physics': dict(
            use_adaptive_physics=False, use_huber_residual=False,
            use_physics_curriculum=False, use_uncertainty_weighting=False,
            alpha_mono=0.0, beta_paris=0.0, gamma_consist=0.0,
            cluster_loss_weight=0.0),
        'A2_adaptive_physics': dict(
            use_adaptive_physics=True, use_huber_residual=False,
            use_physics_curriculum=True, use_uncertainty_weighting=True),
        'A5_no_uncertainty_weight': dict(
            use_adaptive_physics=True, use_huber_residual=False,
            use_physics_curriculum=True, use_uncertainty_weighting=False),
        'A6_no_clustering': dict(
            use_adaptive_physics=True, use_huber_residual=False,
            use_physics_curriculum=True, use_uncertainty_weighting=True,
            cluster_loss_weight=0.0),
    }
    if arms_to_run is None:
        arms_to_run = ['A0_no_physics', 'A2_adaptive_physics']

    C_table = s1['C_table']; m_table = s1['m_table']
    C_median = s1['C_median']; m_median = s1['m_median']
    n_sequences = len(s1['bearing_to_seq'])

    folds = _lobocv_fold_assignment()
    if folds_to_run is not None:
        folds = [f for f in folds if f['fold'] in folds_to_run]

    print("\n[LOBOCV] Precomputing per-bearing GPR weights...")
    full, per_bearing_weights = _precompute_bearing_weights(s1, config)

    cwru_train, cwru_val, cwru_test = (
        s1['cwru_train'], s1['cwru_val'], s1['cwru_test'])
    pader_train, pader_val, pader_test = (
        s1['pader_train'], s1['pader_val'], s1['pader_test'])

    summary = []
    for fold in folds:
        fid = fold['fold']
        print(f"\n{'─' * 80}\nFOLD {fid}  test={fold['test']}  "
              f"val={fold['val']}\n{'─' * 80}")

        p_train, p_val, p_test = _build_fold_data(
            full, per_bearing_weights, fold,
            noise_sigma=target_noise_sigma,
            keep_frac=sparsity_keep_frac,
            input_noise_sigma=input_noise_sigma)
        train_gen = MultiModalDataGeneratorV3(
            cwru_train, pader_train, p_train,
            config.batch_size, shuffle=True, config=config)
        val_gen = MultiModalDataGeneratorV3(
            cwru_val, pader_val, p_val,
            config.batch_size, shuffle=False, config=config)
        test_gen = MultiModalDataGeneratorV3(
            cwru_test, pader_test, p_test,
            config.batch_size, shuffle=False, config=config)

        for arm_name in arms_to_run:
            cached = _lobocv_load(cache_dir, fid, arm_name)
            if cached is not None:
                print(f"  [{arm_name}] cached")
                summary.append({'fold': fid, 'arm': arm_name, **cached})
                continue

            print(f"  [{arm_name}] training...")
            arm_cfg = ConfigV3(**{**config.__dict__, **arms_all[arm_name]})
            arm_cfg.output_dir = os.path.join(cache_dir, f"fold{fid}_{arm_name}")
            os.makedirs(arm_cfg.output_dir, exist_ok=True)

            if arm_cfg.use_adaptive_physics:
                C_use, m_use = C_table.copy(), m_table.copy()
            else:
                C_use = np.full_like(C_table, C_median)
                m_use = np.full_like(m_table, m_median)

            set_reproducible_seed(CURRENT_SEED)
            model = build_model_v3(arm_cfg, n_sequences)
            cur = PhysicsCurriculum(
                lambda_max_mono=arm_cfg.lambda_max_mono,
                lambda_max_paris=arm_cfg.lambda_max_paris,
                lambda_max_consist=arm_cfg.lambda_max_consist,
                k=arm_cfg.curriculum_k, c0=arm_cfg.curriculum_c0)
            trainer = MultiModalTrainerV3(model, arm_cfg, C_use, m_use, cur)
            if arm_cfg.cluster_loss_weight > 0:
                trainer.initialize_cluster_centers(train_gen,
                                                   num_clusters=arm_cfg.n_clusters)

            model_trained, hist, best_vl = train_single_model_v3(
                arm_cfg, train_gen, val_gen, trainer, epochs=arm_cfg.epochs)

            mets = evaluate_v3(model_trained, test_gen, C_use, m_use, arm_cfg)
            record = {'rmse': mets['pronostia_rmse'],
                      'mae': mets['pronostia_mae'],
                      'phy_macro': mets['phy_macro'],
                      'phy_refit_macro': mets['phy_refit_macro'],
                      'best_val_loss': best_vl,
                      'epochs_trained': len(hist['loss'])}
            _lobocv_save(cache_dir, fid, arm_name, record)
            summary.append({'fold': fid, 'arm': arm_name, **record})
            print(f"  [{arm_name}] RMSE={record['rmse']:.4f}  "
                  f"PHY={record['phy_macro']:.4f}")

            import gc; gc.collect()
            tf.keras.backend.clear_session()

    # ---- aggregate + paired test ----
    print(f"\n{'=' * 80}\nAGGREGATE — variant={variant}\n{'=' * 80}")
    agg = {}
    for arm in arms_to_run:
        rs = [r['rmse'] for r in summary if r['arm'] == arm]
        if not rs:
            continue
        agg[arm] = {
            'n_folds': len(rs),
            'rmse_mean': float(np.mean(rs)),
            'rmse_std': float(np.std(rs, ddof=1)) if len(rs) > 1 else 0.0,
            'rmse_per_fold': [float(x) for x in rs],
        }
    for arm, a in agg.items():
        print(f"  {arm:<30} RMSE={a['rmse_mean']:.4f}±{a['rmse_std']:.4f}")

    if 'A0_no_physics' in agg and 'A2_adaptive_physics' in agg:
        diffs = [a2 - a0 for a2, a0 in zip(
            agg['A2_adaptive_physics']['rmse_per_fold'],
            agg['A0_no_physics']['rmse_per_fold'])]
        n = len(diffs)
        wins = sum(1 for d in diffs if d < 0)
        m = float(np.mean(diffs))
        sd = float(np.std(diffs, ddof=1)) if n > 1 else 0.0
        se = sd / np.sqrt(n) if n > 0 else 0.0
        t = m / se if se > 0 else 0.0
        print(f"\n  [A2 vs A0] per-fold diff (A2 − A0):")
        for i, d in enumerate(diffs):
            print(f"    fold {i+1}: {d:+.4f}")
        print(f"    mean {m:+.4f}  std {sd:.4f}  SE {se:.4f}  t={t:+.2f}  "
              f"A2 wins {wins}/{n}")
        if abs(t) >= 2.0:
            print(f"    → |t|={abs(t):.2f} ≥ 2.0: effect is DETECTABLE at "
                  f"α=0.05 (two-sided)")
        else:
            print(f"    → |t|={abs(t):.2f} < 2.0: cannot distinguish from noise")

    agg_path = os.path.join(cache_dir, 'lobocv_aggregate.json')
    with open(agg_path, 'w') as f:
        json.dump({'variant': variant, 'aggregate': agg,
                   'per_fold': summary}, f, indent=2, default=str)
    print(f"\n  ✓ saved {agg_path}")
    return agg

def run_cross_condition(splits=None, arms_to_run=None, epochs_override=40,
                        target_noise_sigma=None):
    """
    Cross-condition LOBOCV: train on one Pronostia condition,
    validate on a bearing from the target condition, test on the
    remaining bearings of the target condition.

    Splits (train_condition -> test_condition):
      'C1_to_C2' : train Bearing1_x,  val=2_1, test=2_2..2_7
      'C2_to_C1' : train Bearing2_x,  val=1_1, test=1_2..1_7
      'C1C2_to_C3': train 1_x + 2_x,  val=3_1, test=3_2, 3_3

    Physics prior (Paris) must help under distribution shift if it is
    to be useful in deployment, where the test condition is unseen.
    """
    print(f"\n{'=' * 80}\nCROSS-CONDITION LOBOCV — Seed {CURRENT_SEED}\n{'=' * 80}")

    s1 = load_stage1()
    config = ConfigV3(**s1['config_dict'])
    config.random_state = CURRENT_SEED
    config.output_dir = STAGE_DIR
    if epochs_override is not None:
        config.epochs = epochs_override

    cache_dir = os.path.join(STAGE_DIR, 'lobocv_cross_condition')
    os.makedirs(cache_dir, exist_ok=True)
    print(f"  cache: {cache_dir}")

    # ---- build the merged 17-bearing pool (same as LOBOCV) ----
    print("\n[CROSS] Precomputing per-bearing GPR weights...")
    full, per_bearing_weights = _precompute_bearing_weights(s1, config)
    X_vib, X_ews, y_rul, bearings, seq_ids, temporal, _ = full

    # ---- define condition groups ----
    cond_groups = {
        'C1': [b for b in ALL_BEARINGS if b.startswith('Bearing1_')],
        'C2': [b for b in ALL_BEARINGS if b.startswith('Bearing2_')],
        'C3': [b for b in ALL_BEARINGS if b.startswith('Bearing3_')],
    }
    print("\n[CROSS] Condition groups:")
    for c, bs in cond_groups.items():
        print(f"  {c}: {bs}")

    # ---- define the split list ----
    all_splits = {
        'C1_to_C2': {
            'train': cond_groups['C1'],
            'val':   ['Bearing2_1'],
            'test':  [b for b in cond_groups['C2'] if b != 'Bearing2_1'],
        },
        'C2_to_C1': {
            'train': cond_groups['C2'],
            'val':   ['Bearing1_1'],
            'test':  [b for b in cond_groups['C1'] if b != 'Bearing1_1'],
        },
        'C1C2_to_C3': {
            'train': cond_groups['C1'] + cond_groups['C2'],
            'val':   ['Bearing3_1'],
            'test':  [b for b in cond_groups['C3'] if b != 'Bearing3_1'],
        },
    }
    if splits is None:
        splits = ['C1_to_C2', 'C2_to_C1', 'C1C2_to_C3']

    arms_all = {
        'A0_no_physics': dict(
            use_adaptive_physics=False, use_huber_residual=False,
            use_physics_curriculum=False, use_uncertainty_weighting=False,
            alpha_mono=0.0, beta_paris=0.0, gamma_consist=0.0,
            cluster_loss_weight=0.0),
        'A2_adaptive_physics': dict(
            use_adaptive_physics=True, use_huber_residual=False,
            use_physics_curriculum=True, use_uncertainty_weighting=True),
    }
    if arms_to_run is None:
        arms_to_run = ['A0_no_physics', 'A2_adaptive_physics']

    C_table = s1['C_table']; m_table = s1['m_table']
    C_median = s1['C_median']; m_median = s1['m_median']
    n_sequences = len(s1['bearing_to_seq'])

    cwru_train, cwru_val, cwru_test = (
        s1['cwru_train'], s1['cwru_val'], s1['cwru_test'])
    pader_train, pader_val, pader_test = (
        s1['pader_train'], s1['pader_val'], s1['pader_test'])

    summary = []
    for split_name in splits:
        spec = all_splits[split_name]
        print(f"\n{'─' * 80}\nSPLIT {split_name}")
        print(f"  train={spec['train']}")
        print(f"  val  ={spec['val']}")
        print(f"  test ={spec['test']}")
        print(f"{'─' * 80}")

        p_train, p_val, p_test = _build_fold_data(
            full, per_bearing_weights, spec,
            noise_sigma=target_noise_sigma)

        train_gen = MultiModalDataGeneratorV3(
            cwru_train, pader_train, p_train,
            config.batch_size, shuffle=True, config=config)
        val_gen = MultiModalDataGeneratorV3(
            cwru_val, pader_val, p_val,
            config.batch_size, shuffle=False, config=config)
        test_gen = MultiModalDataGeneratorV3(
            cwru_test, pader_test, p_test,
            config.batch_size, shuffle=False, config=config)

        for arm_name in arms_to_run:
            cache_path = os.path.join(cache_dir,
                                       f"{split_name}_{arm_name}.json")
            if os.path.exists(cache_path):
                print(f"  [{arm_name}] cached")
                with open(cache_path) as f:
                    cached = json.load(f)
                summary.append({'split': split_name, 'arm': arm_name,
                                **cached})
                continue

            print(f"  [{arm_name}] training...")
            arm_cfg = ConfigV3(**{**config.__dict__, **arms_all[arm_name]})
            arm_cfg.output_dir = os.path.join(
                cache_dir, f"{split_name}_{arm_name}")
            os.makedirs(arm_cfg.output_dir, exist_ok=True)

            if arm_cfg.use_adaptive_physics:
                C_use, m_use = C_table.copy(), m_table.copy()
            else:
                C_use = np.full_like(C_table, C_median)
                m_use = np.full_like(m_table, m_median)

            set_reproducible_seed(CURRENT_SEED)
            model = build_model_v3(arm_cfg, n_sequences)
            cur = PhysicsCurriculum(
                lambda_max_mono=arm_cfg.lambda_max_mono,
                lambda_max_paris=arm_cfg.lambda_max_paris,
                lambda_max_consist=arm_cfg.lambda_max_consist,
                k=arm_cfg.curriculum_k, c0=arm_cfg.curriculum_c0)
            trainer = MultiModalTrainerV3(model, arm_cfg, C_use, m_use, cur)
            if arm_cfg.cluster_loss_weight > 0:
                trainer.initialize_cluster_centers(
                    train_gen, num_clusters=arm_cfg.n_clusters)

            model_trained, hist, best_vl = train_single_model_v3(
                arm_cfg, train_gen, val_gen, trainer, epochs=arm_cfg.epochs)

            mets = evaluate_v3(model_trained, test_gen, C_use, m_use, arm_cfg)
            record = {'rmse': mets['pronostia_rmse'],
                      'mae': mets['pronostia_mae'],
                      'phy_macro': mets['phy_macro'],
                      'phy_refit_macro': mets['phy_refit_macro'],
                      'best_val_loss': best_vl,
                      'epochs_trained': len(hist['loss'])}
            with open(cache_path, 'w') as f:
                json.dump(record, f, indent=2, default=str)
            summary.append({'split': split_name, 'arm': arm_name, **record})
            print(f"  [{arm_name}] RMSE={record['rmse']:.4f}")

            import gc; gc.collect()
            tf.keras.backend.clear_session()

    # ---- paired comparison per split ----
    print(f"\n{'=' * 80}\nCROSS-CONDITION AGGREGATE\n{'=' * 80}")
    split_results = {}
    for split_name in splits:
        a0 = next((r for r in summary
                   if r['split'] == split_name and r['arm'] == 'A0_no_physics'),
                  None)
        a2 = next((r for r in summary
                   if r['split'] == split_name and r['arm'] == 'A2_adaptive_physics'),
                  None)
        if a0 and a2:
            diff = a2['rmse'] - a0['rmse']
            split_results[split_name] = {
                'A0_rmse': a0['rmse'],
                'A2_rmse': a2['rmse'],
                'diff': diff,
            }
            print(f"\n  {split_name}: A0={a0['rmse']:.4f}  A2={a2['rmse']:.4f}  "
                  f"Δ(A2-A0)={diff:+.4f}")

    # ---- across-split summary ----
    if len(split_results) >= 2:
        diffs = [v['diff'] for v in split_results.values()]
        n = len(diffs)
        mean = float(np.mean(diffs))
        sd = float(np.std(diffs, ddof=1)) if n > 1 else 0.0
        se = sd / np.sqrt(n)
        t = mean / se if se > 0 else 0.0
        wins = sum(1 for d in diffs if d < 0)
        print(f"\n  ACROSS SPLITS (A2 - A0): "
              f"mean={mean:+.4f}  SE={se:.4f}  t={t:+.2f}  "
              f"A2 wins {wins}/{n}")
        print(f"  NOTE: only 3 splits → low power. Interpret as "
              f"qualitative, not statistical.")

    agg_path = os.path.join(cache_dir, 'cross_condition_aggregate.json')
    with open(agg_path, 'w') as f:
        json.dump({'splits': split_results, 'per_run': summary},
                  f, indent=2, default=str)
    print(f"\n  ✓ saved {agg_path}")
    return split_results
# =============================================================
# STAGE SELECTOR
# =============================================================

RUN_STAGE = 1 # 1=Data+Gen, 2=Ablation, 3=GPR kernels, 4=UQ,
               # 5=PHY, 6=Robustness, 7=Figures

if __name__ == "__main__":
    RUN_LOBOCV = True
    if RUN_LOBOCV:
        # Diagnostic 1: kinked-linear target (non-Paris)
        run_lobocv(
            folds_to_run=None,
            arms_to_run=['A0_no_physics', 'A2_adaptive_physics'],
            epochs_override=40,
            target_noise_sigma=None,  # second diagnosis   input_noise_sigma=0.20,     # 20% of per-channel std   #forth sparsity_keep_frac=0.10,   # keep only 10% of training windows
            tag_suffix='kinked',  # 2,3,4 'power'
        )
         # add this:
    elif RUN_STAGE == 'cross':
        run_cross_condition(
            splits=['C1_to_C2', 'C2_to_C1', 'C1C2_to_C3'],
            arms_to_run=['A0_no_physics', 'A2_adaptive_physics'],
            epochs_override=40,
        )

    elif RUN_STAGE == 1:
        run_stage_1()
    elif RUN_STAGE == 2:
        run_stage_2()
    elif RUN_STAGE == 3:
        run_stage_3()
    elif RUN_STAGE == 4:
        run_stage_4()
    elif RUN_STAGE == 5:
        run_stage_5()
    elif RUN_STAGE == 6:
        run_stage_6()
    elif RUN_STAGE == 7:
        run_stage_7()
    else:
        raise ValueError(f"Unknown stage {RUN_STAGE}")
